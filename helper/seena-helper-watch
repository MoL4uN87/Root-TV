#!/bin/sh
ROOT=/var/lib/webosbrew/seena-helper
umask 077
exec 9>"$ROOT/watch.lock"
flock -n 9 || exit 0

while :; do
    if ! /usr/bin/curl -fsS --max-time 2 http://127.0.0.1:8787/health >/dev/null 2>&1; then
        SEENA_HELPER_ROOT="$ROOT" SEENA_CURL="$ROOT/curl-impersonate-a55" \
        SEENA_COOKIE_FILE="$ROOT/cookies.json" SEENA_LIB_PATH="$ROOT/armhf-runtime:$ROOT" \
        /usr/bin/node "$ROOT/seena-kinozal-helper.js" 9>&- >>"$ROOT/helper.log" 2>&1 &
    fi
    sleep 10
done
