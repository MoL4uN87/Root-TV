#!/bin/sh
ROOT=/var/lib/webosbrew/seena-helper
if [ ! -f "$ROOT/seena-kinozal-helper.js" ] || [ ! -f "$ROOT/seena-helper-watch" ] || [ ! -x "$ROOT/curl-impersonate-a55" ]; then
    exit 0
fi
if [ -x /var/lib/webosbrew/lgvpn/lgvpn-start ]; then
    (
        i=0
        while [ "$i" -lt 12 ]; do
            if /var/lib/webosbrew/lgvpn/lgvpn-status 2>/dev/null | grep -q '^CONNECTED'; then exit 0; fi
            /var/lib/webosbrew/lgvpn/lgvpn-start >/dev/null 2>&1 || true
            if /var/lib/webosbrew/lgvpn/lgvpn-status 2>/dev/null | grep -q '^CONNECTED'; then exit 0; fi
            i=$((i + 1))
            sleep 5
        done
    ) </dev/null >/dev/null 2>&1 &
fi
nohup /bin/sh "$ROOT/seena-helper-watch" </dev/null >/dev/null 2>&1 &
exit 0
